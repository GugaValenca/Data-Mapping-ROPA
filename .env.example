# Copy this file to .env (or set these as real environment variables on
# your host, e.g. Render's/PythonAnywhere's dashboard) and fill in real
# values. Never commit an actual .env file — it's already in .gitignore.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-freshly-generated-secret-key

# Keep True for local development. Set to False for any real deployment.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the app.
# Required (non-empty) once DJANGO_DEBUG=False.
# Example: DJANGO_ALLOWED_HOSTS=data-mapping-ropa.onrender.com
DJANGO_ALLOWED_HOSTS=
